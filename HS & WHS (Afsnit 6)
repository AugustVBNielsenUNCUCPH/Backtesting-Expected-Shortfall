## B.4 Vægtning i WHS

```{r figur_vaegt, fig.width=10, fig.height=5, dpi=300}
farver_vaegt <- c("125" = "#FF4500", "250" = "darkorange2", "500" = "#FFD700", "1000" = "#228B22")

df_vaegt <- data.frame()
for (ww in m_seq) {
  tau <- 1:ww
  df_vaegt <- rbind(df_vaegt, data.frame(
    tau = tau, v_tau = (1 - v) * v^(tau - 1) / (1 - v^ww), m = as.character(ww)))
}
df_vaegt$m <- factor(df_vaegt$m, levels = as.character(m_seq))

labels_v <- c("125" = expression(m == 125), "250" = expression(m == 250),
              "500" = expression(m == 500), "1000" = expression(m == 1000))

ggplot(df_vaegt, aes(x = tau, y = v_tau, color = m, linetype = m)) +
  geom_line(linewidth = 0.9) +
  scale_color_manual(values = farver_vaegt, labels = labels_v) +
  scale_linetype_manual(values = c("125" = "solid", "250" = "solid",
                                   "500" = "solid", "1000" = "dashed"), labels = labels_v) +
  labs(title = bquote("Vægte " ~ v[tau] ~ " ved varierende vindueslængde, " ~ eta == .(v)),
       x = expression(tau), y = expression(v[tau]), color = "", linetype = "") +
  theme_minimal() + theme(legend.position = "bottom", plot.title = element_text(hjust = 0.5))
```

