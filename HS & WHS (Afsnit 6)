est <- res_h$est250

# Gennemsnitlig estimeret ES på de dage hvor VaR overskrides (indeksering, ikke vægtning)
ES_betinget <- function(ES_est, X_obs, VaR_ref) mean(ES_est[X_obs < -VaR_ref], na.rm = TRUE)

tabel_b7 <- data.frame(
  Beregningsmetode = c("Parametrisk (GARCH)", "Ikke-parametrisk (HS)", "Ikke-parametrisk (WHS)"),
  `VaR frekvens` = c(mean(VaR_stat(est$X_t, est$VaR_g)),
                     mean(VaR_stat(est$X_t, est$VaR_h)),
                     mean(VaR_stat(est$X_t, est$VaR_w))),
  `Gns. est. ES | Egen VaR` = c(ES_betinget(est$ES_g, est$X_t, est$VaR_g),
                                ES_betinget(est$ES_h, est$X_t, est$VaR_h),
                                ES_betinget(est$ES_w, est$X_t, est$VaR_w)),
  `Gns. est. ES | GARCH VaR` = c(ES_betinget(est$ES_g, est$X_t, est$VaR_g),
                                 ES_betinget(est$ES_h, est$X_t, est$VaR_g),
                                 ES_betinget(est$ES_w, est$X_t, est$VaR_g)),
  check.names = FALSE)

