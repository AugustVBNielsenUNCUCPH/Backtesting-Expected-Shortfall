col_obs <- "deeppink3"

plot_d <- function(d_obs, navn, xmax = 100) {
  bins  <- seq(0, max(d_ref, d_obs) + 5, by = 5)
  h_ref <- hist(d_ref, breaks = bins, plot = FALSE)
  h_obs <- hist(d_obs, breaks = bins, plot = FALSE)
  plot(h_ref, freq = FALSE, col = adjustcolor(col_H0, 0.5), border = col_H0,
       xlim = c(0, xmax), ylim = c(0, max(h_ref$density, h_obs$density) * 1.05),
       xlab = expression(d[i]), ylab = "Taethed", las = 1,
       main = bquote(.(navn)*": fordeling af "*d[i]*" | "*alpha == 0.025))
  plot(h_obs, freq = FALSE, col = adjustcolor(col_obs, 0.5), border = col_obs, add = TRUE)
  legend("topright", bty = "n",
         legend = c(expression(H[0]*": Geom("*alpha*")"), "Observeret"),
         fill = adjustcolor(c(col_H0, col_obs), 0.5), border = c(col_H0, col_obs))
}

plot_H <- function(H_obs, navn) {
  bins  <- seq(0, 1, by = 0.1)
  h_ref <- hist(H_ref, breaks = bins, plot = FALSE)
  h_obs <- hist(H_obs, breaks = bins, plot = FALSE)
  plot(h_ref, freq = FALSE, col = adjustcolor(col_H0, 0.5), border = col_H0,
       xlim = c(0, 1), ylim = c(0, max(h_ref$density, h_obs$density) * 1.1),
       xlab = expression(H[i]), ylab = "Taethed", las = 1,
       main = bquote(.(navn)*": fordeling af "*H[i]))
  plot(h_obs, freq = FALSE, col = adjustcolor(col_obs, 0.5), border = col_obs, add = TRUE)
  legend("topright", bty = "n",
         legend = c(expression(H[0]*": U(0, 1)"), "Observeret"),
         fill = adjustcolor(c(col_H0, col_obs), 0.5), border = c(col_H0, col_obs))
}

