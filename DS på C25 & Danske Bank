```{r analyse, cache=TRUE}
# Fuld analyse for ét aktiv: observerede teststørrelser, kritiske værdier (H0) og styrke (fri nu)
analyser_case <- function(case) {
  data  <- hent_afkast(case$ticker, case$start, case$end)
  X     <- data$afkast
  dates <- data$date
  n     <- length(X)
  oos   <- min(which(dates >= as.Date(case$split)))
  oos_idx <- oos:n

  is_fit  <- fit_garch(X[1:(oos - 1)])
  oos_fit <- fit_garch(X[oos:n])
  nu  <- is_fit$nu
  tau <- sqrt((nu - 2) / nu)

  # Prædiktiv volatilitet fra IS-fittet, OOS-vinduet
  sigma <- filter_sigma(X, is_fit)[oos_idx]
  X_oos <- X[oos_idx]
  n_oos <- length(oos_idx)

  X_mat   <- matrix(X_oos, nrow = 1)
  sig_mat <- matrix(sigma, nrow = 1)
  VaR     <- VaR_GARCH_stdt(sig_mat, alpha, nu)
  VaR_1   <- VaR_GARCH_stdt(sig_mat, alpha_VaRtest, nu)
  ES      <- ES_GARCH_stdt(sig_mat, alpha, nu)

  dH_obs <- ds_di_Hi(X_oos, sigma, as.numeric(VaR), alpha, nu)
  ds_obs <- ds_test_di_Hi(dH_obs$d, dH_obs$H, alpha, K_uni, K_biv)

  # H0-kalibrering via IS-fittet GARCH
  sim0  <- simulate_garch(n_oos, is_fit$omega, is_fit$alpha, is_fit$beta, nu, burn_in_MC, M0_crit)
  VaR0  <- VaR_GARCH_stdt(sim0$sigma, alpha, nu)
  VaR0_1 <- VaR_GARCH_stdt(sim0$sigma, alpha_VaRtest, nu)
  ES0   <- ES_GARCH_stdt(sim0$sigma, alpha, nu)
  CC0   <- cc_stat(sim0$X, VaR0, ES0, alpha)
  ds0   <- ds_stat_matrix(sim0$X, sim0$sigma, VaR0, alpha, nu)

  crit <- list(
    VaR = quantile(VaR_stat_GARCH(sim0$X, VaR0_1), 1 - signifikansniveau, na.rm = TRUE),
    Z2  = quantile(Z2_test_GARCH(sim0$X, VaR0, ES0, alpha), signifikansniveau, na.rm = TRUE),
    Z3  = quantile(Z3_test_GARCH(sim0$X, sim0$sigma, alpha, nu), signifikansniveau, na.rm = TRUE),
    ER  = quantile(ER_test_GARCH(sim0$X, ES0, VaR0, sim0$sigma), signifikansniveau, na.rm = TRUE),
    CC  = signifikansniveau,
    T_F = quantile(ds0[, "T_F"], 1 - signifikansniveau, na.rm = TRUE),
    T_S = quantile(ds0[, "T_S"], 1 - signifikansniveau, na.rm = TRUE),
    T_G = quantile(ds0[, "T_G"], 1 - signifikansniveau, na.rm = TRUE))

  obs <- c(
    VaR = unname(VaR_stat_GARCH(X_mat, VaR_1)),
    Z2  = unname(Z2_test_GARCH(X_mat, VaR, ES, alpha)),
    Z3  = unname(Z3_test_GARCH(X_mat, sig_mat, alpha, nu)),
    ER  = unname(ER_test_GARCH(X_mat, ES, VaR, sig_mat)),
    CC  = unname(cc_pvalue(CC0, cc_stat(X_mat, VaR, ES, alpha))),
    T_F = unname(ds_obs["T_F"]), T_S = unname(ds_obs["T_S"]), T_G = unname(ds_obs["T_G"]))

  # H1 = fuldt OOS-fit (fri nu); modellen bruger IS-dynamik og IS-nu
  sim1  <- simulate_garch(n_oos, oos_fit$omega, oos_fit$alpha, oos_fit$beta, oos_fit$nu, burn_in_MC, M_power)
  sig1  <- simulate_sigma_from_X(sim1$X, is_fit$omega, is_fit$alpha, is_fit$beta)
  VaR1  <- VaR_GARCH_stdt(sig1, alpha, nu)
  VaR1_1 <- VaR_GARCH_stdt(sig1, alpha_VaRtest, nu)
  ES1   <- ES_GARCH_stdt(sig1, alpha, nu)
  CC1   <- cc_stat(sim1$X, VaR1, ES1, alpha)
  ds1   <- ds_stat_matrix(sim1$X, sig1, VaR1, alpha, nu)

  power <- list(
    VaR = mean(VaR_stat_GARCH(sim1$X, VaR1_1) > crit$VaR, na.rm = TRUE),
    Z2  = mean(Z2_test_GARCH(sim1$X, VaR1, ES1, alpha) < crit$Z2, na.rm = TRUE),
    Z3  = mean(Z3_test_GARCH(sim1$X, sig1, alpha, nu) < crit$Z3, na.rm = TRUE),
    ER  = mean(ER_test_GARCH(sim1$X, ES1, VaR1, sig1) < crit$ER, na.rm = TRUE),
    CC  = mean(cc_pvalue(CC0, CC1) < signifikansniveau, na.rm = TRUE),
    T_F = mean(ds1[, "T_F"] > crit$T_F, na.rm = TRUE),
    T_S = mean(ds1[, "T_S"] > crit$T_S, na.rm = TRUE),
    T_G = mean(ds1[, "T_G"] > crit$T_G, na.rm = TRUE))

  list(case = case, is_fit = is_fit, oos_fit = oos_fit, n_oos = n_oos,
       n_exc = length(dH_obs$d), sd_ratio = sd(X_oos) / sd(X[1:(oos - 1)]),
       is_periode  = paste(format(dates[1], "%d.%m.%Y"), "-", format(dates[oos - 1], "%d.%m.%Y")),
       oos_periode = paste(format(dates[oos], "%d.%m.%Y"), "-", format(dates[n], "%d.%m.%Y")),
       obs = obs, crit = crit, power = power, dH = dH_obs)
}

set.seed(2026)
res <- lapply(cases, analyser_case)
```

