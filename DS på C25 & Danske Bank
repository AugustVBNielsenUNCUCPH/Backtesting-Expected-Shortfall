## Tabel: Observerede teststørrelser

```{r tabel_observeret, results='asis'}
obs_tabel <- function(r) {
  o <- r$obs; cv <- r$crit
  retning <- c(VaR = 1, Z2 = -1, Z3 = -1, ER = -1, CC = -1, T_F = 1, T_S = 1, T_G = 1)
  navne   <- c("VaR_{1%}", "Z2", "Z3", "ER", "CC", "T_F", "T_S", "T_G")
  keys    <- c("VaR", "Z2", "Z3", "ER", "CC", "T_F", "T_S", "T_G")
  vaerdi  <- o[keys]
  kritisk <- c(cv$VaR, cv$Z2, cv$Z3, cv$ER, cv$CC, cv$T_F, cv$T_S, cv$T_G)
  afvis   <- ifelse(retning > 0, vaerdi > kritisk, vaerdi < kritisk)
  data.frame(Test = navne, Observeret = round(vaerdi, 3), Kritisk = round(kritisk, 3),
             Afvises = ifelse(afvis, "Ja", "Nej"), check.names = FALSE)
}

for (r in res) {
  cat(knitr::kable(obs_tabel(r), row.names = FALSE,
    caption = paste0("Observerede teststørrelser, ", r$case$navn,
                     ". CC er den samlede Bonferroni-p-værdi. M = ", M0_crit,
                     ", signifikansniveau ", signifikansniveau, ".")), sep = "\n")
  cat("\n\n")
}
