```{r datafunktioner}
# Daglige log-afkast i procent (×100 for numerisk stabilitet i GARCH-fittet)
hent_afkast <- function(ticker, start, end) {
  px <- na.omit(Ad(getSymbols(ticker, from = start, to = end, auto.assign = FALSE, src = "yahoo")))
  data.frame(date = index(px)[-1], afkast = diff(log(as.numeric(px))) * 100)
}

fit_garch <- function(X) {
  spec <- ugarchspec(
    variance.model     = list(model = "sGARCH", garchOrder = c(1, 1)),
    mean.model         = list(armaOrder = c(0, 0), include.mean = FALSE),
    distribution.model = "std")
  par <- coef(ugarchfit(spec, data = X, solver = "hybrid",
                        fit.control = list(stationarity = 1)))
  list(omega = as.numeric(par["omega"]), alpha = as.numeric(par["alpha1"]),
       beta  = as.numeric(par["beta1"]), nu = as.numeric(par["shape"]))
}

filter_sigma <- function(X, par) {
  spec <- ugarchspec(
    variance.model     = list(model = "sGARCH", garchOrder = c(1, 1)),
    mean.model         = list(armaOrder = c(0, 0), include.mean = FALSE),
    distribution.model = "std",
    fixed.pars = list(omega = par$omega, alpha1 = par$alpha, beta1 = par$beta, shape = par$nu))
  as.numeric(sigma(ugarchfilter(spec, data = X)))
}
