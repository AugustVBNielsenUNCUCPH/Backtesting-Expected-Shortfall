```{r teststoerrelser}
# GARCH(1,1) simulation, M stier
simulate_garch <- function(T_sti, omega, alpha1, beta1, nu, burn_in, M) {
  total <- T_sti + burn_in
  tau   <- sqrt((nu - 2) / nu)
  X    <- matrix(0, M, total)
  sig2 <- matrix(0, M, total)
  sig2[, 1] <- omega / (1 - alpha1 - beta1)
  for (t in 2:total) {
    z         <- rt(M, df = nu) * tau
    X[, t-1]  <- sqrt(sig2[, t-1]) * z
    sig2[, t] <- omega + alpha1 * X[, t-1]^2 + beta1 * sig2[, t-1]
  }
  list(X     = X[, (burn_in+1):(burn_in+T_sti), drop = FALSE],
       sigma = sqrt(sig2[, (burn_in+1):(burn_in+T_sti), drop = FALSE]))
}

# Filtrér sigma fra givne afkast under faste parametre
simulate_sigma_from_X <- function(X, omega, alpha1, beta1) {
  M <- nrow(X); T_sti <- ncol(X)
  sig2 <- matrix(0, M, T_sti)
  sig2[, 1] <- omega / (1 - alpha1 - beta1)
  for (t in 2:T_sti) sig2[, t] <- omega + alpha1 * X[, t-1]^2 + beta1 * sig2[, t-1]
  sqrt(sig2)
}

# Parametrisk VaR og ES under standardiseret t
VaR_GARCH_stdt <- function(sigma, alpha, nu) -sigma * qt(alpha, nu) * sqrt((nu - 2) / nu)

ES_GARCH_stdt <- function(sigma, alpha, nu) {
  q <- qt(alpha, nu)
  sigma * sqrt((nu - 2) / nu) * (dt(q, nu) / alpha) * (nu + q^2) / (nu - 1)
}

Z2_test_GARCH <- function(X, VaR, ES, alpha) {
  I <- (X + VaR < 0)
  rowMeans((X * I) / (alpha * ES)) + 1
}

Z3_test_GARCH <- function(X, sigma, alpha, nu) {
  z <- X / sigma
  U <- pmin(pmax(pt(z * sqrt(nu / (nu - 2)), df = nu), 1e-10), 1 - 1e-10)
  U_sorted <- t(apply(U, 1, sort, method = "quick"))
  q <- qt(U_sorted, df = nu)
  k <- floor(ncol(X) * alpha)
  ES_emp  <- -rowMeans(q[, 1:k, drop = FALSE])
  q_alpha <- qt(alpha, nu)
  ES_theo <- (dt(q_alpha, nu) / alpha) * (nu + q_alpha^2) / (nu - 1)
  1 - (ES_emp / ES_theo)
}

ER_test_GARCH <- function(X, ES, VaR, sigma) {
  I    <- (X + VaR < 0)
  r    <- ((X + ES) * I) / sigma
  rbar <- rowSums(r) / rowSums(I)
  rbar[!is.finite(rbar)] <- NA
  rbar
}

VaR_stat_GARCH <- function(X, VaR) rowSums(X + VaR < 0)

# CC-teststørrelse, M stier. Returnerer M x 2 (frekvens, severity).
cc_stat <- function(X, VaR, ES, alpha) {
  Tn  <- ncol(X)
  ind <- (X + VaR < 0) * 1
  V1  <- alpha - ind
  V2  <- VaR - ES - (1/alpha) * ind * (VaR + X)
  cbind(sqrt(Tn) * rowMeans(V1) / sqrt(rowMeans(V1^2)),
        sqrt(Tn) * rowMeans(V2) / sqrt(rowMeans(V2^2)))
}

# Empirisk Bonferroni-p-værdi. Komponent 1 (frekvens) nedre hale, komponent 2 (severity) øvre hale.
cc_pvalue <- function(CC_null, CC) {
  p1 <- ecdf(CC_null[, 1])(CC[, 1])
  p2 <- 1 - ecdf(CC_null[, 2])(CC[, 2])
  pmin(2 * pmin(p1, p2), 1)
}

# Udtræk durations d_i og severities H_i fra én sti
ds_di_Hi <- function(X, sigma, VaR, alpha, nu) {
  tau <- sqrt((nu - 2) / nu)
  idx <- which(X < -VaR)
  if (length(idx) < 2) return(list(d = integer(0), H = numeric(0)))
  d <- diff(c(0, idx))
  u <- pmin(pmax(pt(X[idx] / (sigma[idx] * tau), df = nu), 1e-10), 1 - 1e-10)
  H <- pmin(pmax((alpha - u) / alpha, 1e-10), 1 - 1e-10)
  list(d = d, H = H)
}

# DS-teststørrelser for alle M stier
ds_stat_matrix <- function(X, sigma, VaR, alpha, nu) {
  t(sapply(1:nrow(X), function(m) {
    dH <- ds_di_Hi(X[m, ], sigma[m, ], VaR[m, ], alpha, nu)
    ds_test_di_Hi(dH$d, dH$H, alpha, K_uni, K_biv)
  }))
}
